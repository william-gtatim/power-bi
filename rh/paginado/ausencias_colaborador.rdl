<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df"
  xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition"
  xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"
  xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <rd:ReportUnitType>Cm</rd:ReportUnitType>
  <rd:ReportID>9327dbe9-0536-4782-8eb1-7ebf445e6ba1</rd:ReportID>
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <Description>Ausências por colaborador num mês (uma página por colaborador). Gerado por rh/paginado/gerar_rdl_ausencias.js.</Description>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Neon">
      <ConnectionProperties>
        <DataProvider>ODBC</DataProvider>
        <ConnectString>Driver={PostgreSQL Unicode(x64)};Server=ep-blue-pond-beysn29j-pooler.c-9.us-east-2.aws.neon.tech;Port=5432;Database=neondb;SSLmode=require</ConnectString>
        <Prompt>Utilizador e password do PostgreSQL (Neon):</Prompt>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>bd782221-4039-4f28-a879-a67d0aab4011</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="dsMeses">
      <Query>
        <DataSourceName>Neon</DataSourceName>
        <CommandText>SELECT DISTINCT c.ano_mes, c.nome_mes || ' de ' || c.ano AS rotulo
FROM rh.calendario c
WHERE EXISTS (SELECT 1 FROM rh.ausencias a WHERE to_char(a.data_inicio, 'YYYY-MM') = c.ano_mes)
ORDER BY c.ano_mes DESC</CommandText>
      </Query>
      <Fields>
        <Field Name="ano_mes">
          <DataField>ano_mes</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="rotulo">
          <DataField>rotulo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsColaboradores">
      <Query>
        <DataSourceName>Neon</DataSourceName>
        <CommandText>="SELECT DISTINCT c.id, c.colaborador FROM rh.vw_colaboradores c JOIN rh.ausencias a ON a.colaborador_id = c.id WHERE to_char(a.data_inicio, 'YYYY-MM') = '" &amp; Replace(Parameters!Mes.Value, "'", "''") &amp; "' ORDER BY c.colaborador"</CommandText>
      </Query>
      <Fields>
        <Field Name="id">
          <DataField>id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="colaborador">
          <DataField>colaborador</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsColaboradoresPadrao">
      <Query>
        <DataSourceName>Neon</DataSourceName>
        <CommandText>="SELECT c.id FROM rh.vw_colaboradores c JOIN rh.ausencias a ON a.colaborador_id = c.id WHERE to_char(a.data_inicio, 'YYYY-MM') = '" &amp; Replace(Parameters!Mes.Value, "'", "''") &amp; "' GROUP BY c.id, c.colaborador ORDER BY count(*) DESC, c.colaborador LIMIT 3"</CommandText>
      </Query>
      <Fields>
        <Field Name="id">
          <DataField>id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Ausencias">
      <Query>
        <DataSourceName>Neon</DataSourceName>
        <CommandText>="SELECT c.id AS colaborador_id, c.colaborador, c.departamento, c.cargo, a.tipo, a.data_inicio, a.data_fim, a.dias_uteis FROM rh.ausencias a JOIN rh.vw_colaboradores c ON c.id = a.colaborador_id WHERE to_char(a.data_inicio, 'YYYY-MM') = '" &amp; Replace(Parameters!Mes.Value, "'", "''") &amp; "' AND c.id IN (" &amp; Join(Parameters!Colaboradores.Value, ",") &amp; ") ORDER BY c.colaborador, a.tipo, a.data_inicio"</CommandText>
      </Query>
      <Fields>
        <Field Name="colaborador_id">
          <DataField>colaborador_id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="colaborador">
          <DataField>colaborador</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="departamento">
          <DataField>departamento</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="cargo">
          <DataField>cargo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="tipo">
          <DataField>tipo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="data_inicio">
          <DataField>data_inicio</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="data_fim">
          <DataField>data_fim</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="dias_uteis">
          <DataField>dias_uteis</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportSections>

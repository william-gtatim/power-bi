		lineageTag: 23d056fd-a43c-4dc4-9067-4a8d70fb5020
		summarizeBy: none
		sourceColumn: dia_util

	partition calendario = m
		mode: import
		source =
				let
				  Origem = PostgreSQL.Database(Servidor, BaseDados),
				  Tabela = Origem{[Schema = "rh", Item = "calendario"]}[Data],
				  Tipos = Table.TransformColumnTypes(Tabela, {{"data", type date}, {"ano", Int64.Type}, {"trimestre", Int64.Type}, {"mes", Int64.Type}, {"dia", Int64.Type}, {"dia_semana", Int64.Type}})
				in
				  Tipos

